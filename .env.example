DATABASE_URL=postgres://postgres:replace-me@localhost:5432/proofloom
OPERATOR_REVIEW_KEY=replace-with-32-plus-cryptographically-random-characters
NODE_ENV=development
PORT=3000
BRIDGE_API_KEY=replace-with-32-plus-random-characters
VERIFIER_API_KEY=replace-with-different-32-plus-random-characters
BRIDGE_ENABLED=false
BRIDGE_REPOSITORY=Noetfield-Systems/Proofloom-Genesis
QA_ENABLED=false

# GitHub Actions (repository secrets, NOT Railway variables):
# PROOFLOOM_GITHUB_APP_ID, PROOFLOOM_GITHUB_APP_PRIVATE_KEY
# PROOFLOOM_BRIDGE_API_KEY (same value as Railway BRIDGE_API_KEY)
# PROOFLOOM_VERIFIER_API_KEY (same value as Railway VERIFIER_API_KEY)
# GitHub Actions variables PROOFLOOM_BRIDGE_RUNNER_ENABLED and PROOFLOOM_BRIDGE_VERIFIER_ENABLED default off.
